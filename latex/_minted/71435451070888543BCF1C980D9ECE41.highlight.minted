\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{relax}\PYG{p}{(}\PYG{n}{pile}\PYG{p}{:} \PYG{n}{Pile}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n+nb}{tuple}\PYG{p}{[}\PYG{n+nb}{int}\PYG{p}{,} \PYG{n+nb}{int}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{} Repeatedly find and topple unstable cells until the pile is stable. Returns number of topplings and number of lost grains}

\PYG{l+s+sd}{    \PYGZgt{}\PYGZgt{}\PYGZgt{} pile = [[1, 2, 3, 4], [1, 2, 3, 4]]}
\PYG{l+s+sd}{    \PYGZgt{}\PYGZgt{}\PYGZgt{} result = relax(pile)}
\PYG{l+s+sd}{    \PYGZgt{}\PYGZgt{}\PYGZgt{} result}
\PYG{l+s+sd}{    (4, 6)}
\PYG{l+s+sd}{    \PYGZgt{}\PYGZgt{}\PYGZgt{} pile}
\PYG{l+s+sd}{    [[1, 3, 1, 2], [1, 3, 1, 2]]}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{n}{number\PYGZus{}of\PYGZus{}topplings} \PYG{o}{=} \PYG{l+m+mi}{0}
    \PYG{n}{number\PYGZus{}of\PYGZus{}lost\PYGZus{}grains} \PYG{o}{=} \PYG{l+m+mi}{0}

    \PYG{n}{len\PYGZus{}row} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{pile}\PYG{p}{)}
    \PYG{n}{len\PYGZus{}column} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{pile}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{])}

    \PYG{n}{i} \PYG{o}{=} \PYG{l+m+mi}{0}
    \PYG{n}{j} \PYG{o}{=} \PYG{l+m+mi}{0}

    \PYG{k}{while} \PYG{n}{i} \PYG{o}{\PYGZlt{}} \PYG{n}{len\PYGZus{}row}\PYG{p}{:}
        \PYG{k}{if} \PYG{n}{pile}\PYG{p}{[}\PYG{n}{i}\PYG{p}{][}\PYG{n}{j}\PYG{p}{]} \PYG{o}{\PYGZgt{}=} \PYG{l+m+mi}{4}\PYG{p}{:}
            \PYG{n}{number\PYGZus{}of\PYGZus{}lost\PYGZus{}grains} \PYG{o}{+=} \PYG{n}{topple}\PYG{p}{(}\PYG{n}{pile}\PYG{p}{,} \PYG{n}{i}\PYG{p}{,} \PYG{n}{j}\PYG{p}{)}
            \PYG{n}{number\PYGZus{}of\PYGZus{}topplings} \PYG{o}{+=} \PYG{l+m+mi}{1}

            \PYG{c+c1}{\PYGZsh{} go back after toppling}
            \PYG{k}{if} \PYG{n}{i} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0}\PYG{p}{:}        \PYG{c+c1}{\PYGZsh{} if north neighbor exists go north}
                \PYG{n}{i} \PYG{o}{\PYGZhy{}=} \PYG{l+m+mi}{1}
            \PYG{k}{elif} \PYG{n}{j} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0}\PYG{p}{:}      \PYG{c+c1}{\PYGZsh{} else if west}
                \PYG{n}{j} \PYG{o}{\PYGZhy{}=} \PYG{l+m+mi}{1}
            \PYG{c+c1}{\PYGZsh{} else stay at (0, 0)}

        \PYG{k}{else}\PYG{p}{:}
            \PYG{n}{j} \PYG{o}{+=} \PYG{l+m+mi}{1}           \PYG{c+c1}{\PYGZsh{} go east}
            \PYG{k}{if} \PYG{n}{j} \PYG{o}{==} \PYG{n}{len\PYGZus{}column}\PYG{p}{:}  \PYG{c+c1}{\PYGZsh{} end of row}
                \PYG{n}{j} \PYG{o}{=} \PYG{l+m+mi}{0}
                \PYG{n}{i} \PYG{o}{+=} \PYG{l+m+mi}{1}

    \PYG{k}{return} \PYG{n}{number\PYGZus{}of\PYGZus{}topplings}\PYG{p}{,} \PYG{n}{number\PYGZus{}of\PYGZus{}lost\PYGZus{}grains}

