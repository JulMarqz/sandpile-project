\begin{MintedVerbatim}[commandchars=\\\{\}]
    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{topple}\PYG{p}{(}\PYG{n}{pile}\PYG{p}{:} \PYG{n}{Pile}\PYG{p}{,} \PYG{n}{row}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,} \PYG{n}{column}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n+nb}{int}\PYG{p}{:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{} Topple one unstable cell once and return the grains lost at the edge.}
\PYG{l+s+sd}{    The cell is assumed to have height at least four. The pile is changed}
\PYG{l+s+sd}{    in place.}

\PYG{l+s+sd}{    \PYGZgt{}\PYGZgt{}\PYGZgt{} pile = [[4, 1],[2, 2]]}
\PYG{l+s+sd}{    \PYGZgt{}\PYGZgt{}\PYGZgt{} topple(pile, 0, 0)}
\PYG{l+s+sd}{    2}
\PYG{l+s+sd}{    \PYGZgt{}\PYGZgt{}\PYGZgt{} pile}
\PYG{l+s+sd}{    [[0, 2], [3, 2]]}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{n}{lost} \PYG{o}{=} \PYG{l+m+mi}{0}
    \PYG{n}{pile}\PYG{p}{[}\PYG{n}{row}\PYG{p}{][}\PYG{n}{column}\PYG{p}{]} \PYG{o}{\PYGZhy{}=} \PYG{l+m+mi}{4}

    \PYG{c+c1}{\PYGZsh{} if north neighbor exists}
    \PYG{k}{if} \PYG{n}{row} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0}\PYG{p}{:}
        \PYG{n}{pile}\PYG{p}{[}\PYG{n}{row} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}\PYG{p}{][}\PYG{n}{column}\PYG{p}{]} \PYG{o}{+=} \PYG{l+m+mi}{1}
    \PYG{k}{else}\PYG{p}{:}
        \PYG{n}{lost} \PYG{o}{+=} \PYG{l+m+mi}{1}

    \PYG{c+c1}{\PYGZsh{} if south neighbor exists}
    \PYG{k}{if} \PYG{n}{row} \PYG{o}{\PYGZlt{}} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{pile}\PYG{p}{)} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}\PYG{p}{:}
        \PYG{n}{pile}\PYG{p}{[}\PYG{n}{row} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{p}{][}\PYG{n}{column}\PYG{p}{]} \PYG{o}{+=} \PYG{l+m+mi}{1}
    \PYG{k}{else}\PYG{p}{:}
        \PYG{n}{lost} \PYG{o}{+=} \PYG{l+m+mi}{1}

    \PYG{c+c1}{\PYGZsh{} if west neighbor exists}
    \PYG{k}{if} \PYG{n}{column} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0}\PYG{p}{:}
        \PYG{n}{pile}\PYG{p}{[}\PYG{n}{row}\PYG{p}{][}\PYG{n}{column} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}\PYG{p}{]} \PYG{o}{+=} \PYG{l+m+mi}{1}
    \PYG{k}{else}\PYG{p}{:}
        \PYG{n}{lost} \PYG{o}{+=} \PYG{l+m+mi}{1}

    \PYG{c+c1}{\PYGZsh{} if east neighbor exists}
    \PYG{k}{if} \PYG{n}{column} \PYG{o}{\PYGZlt{}} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{pile}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{])} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}\PYG{p}{:}
        \PYG{n}{pile}\PYG{p}{[}\PYG{n}{row}\PYG{p}{][}\PYG{n}{column} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{p}{]} \PYG{o}{+=} \PYG{l+m+mi}{1}
    \PYG{k}{else}\PYG{p}{:}
        \PYG{n}{lost} \PYG{o}{+=} \PYG{l+m+mi}{1}

    \PYG{k}{return} \PYG{n}{lost}
\end{MintedVerbatim}
